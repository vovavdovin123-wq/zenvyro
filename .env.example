TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=zenvyro_bot
TELEGRAM_ADMIN_CHAT_IDS=
# Локально в РФ: прокси через Vercel, без VPN
# TELEGRAM_API_ROOT=https://zenvyro.vercel.app/api/telegram/tg
# На самом Vercel эту переменную НЕ ставить — там прямой api.telegram.org

# Python-бот @zenvyro_bot: заявки с формы уходят сюда
ORDER_BOT_WEBHOOK_URL=http://127.0.0.1:8090/webhook/new-order
ORDER_BOT_WEBHOOK_SECRET=

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

NEXT_PUBLIC_SITE_URL=https://zenvyro.vercel.app

STUDIO_PASSWORD=zenvyro
# На проде пароль обязателен: пустой STUDIO_PASSWORD закрывает /studio
# /studio — дашборд: посетители, воронка заявок, заказы (сайт + фриланс)
STUDIO_MIN_BUDGET=5000

# Необязательно: Dev-агент делает один этап = один PR в Cursor
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_REPO=

# Граф кода через CLI codebase-memory-mcp (без MCP). Бинарник: install.ps1 --skip-config
CBM_BIN=
# Локальный checkout клиентского репо; пусто = этот репозиторий
CODEBASE_MEMORY_REPO=

# Без ключа агенты идут в фолбэк, токены = 0. С ключом расход виден в /studio.
# OPENAI_API_KEY=
